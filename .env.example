# Copiá este archivo como .env.local para probar en tu compu.
# En Vercel cargá las mismas variables en Settings › Environment Variables.

# Públicas (van al navegador). Supabase › Project Settings › API
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=

# Píxel de Meta. Events Manager › Orígenes de datos › tu píxel. Vacío = sin píxel.
VITE_META_PIXEL_ID=

# Privadas (solo servidor). NUNCA con prefijo VITE_
SUPABASE_URL=https://TU-PROYECTO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Con www. El dominio sin www redirige y los avisos de pago no siguen redirecciones.
PORTAL_URL=https://www.firmasvc.com

# Pagos con tarjeta con dLocal Go (solo servidor). Guía en PORTAL.md, sección Pagos con tarjeta.
# Sin la API key y la secret key, el pago aparece como no disponible.
DLOCALGO_API_KEY=
DLOCALGO_SECRET_KEY=
# sandbox o produccion. Vacío es sandbox, así nadie cobra de verdad por error.
DLOCALGO_ENTORNO=sandbox
# Obligatoria. Clave para los avisos de cada plan (openssl rand -hex 32).
DLOCALGO_CLAVE_AVISOS=

# Mails con Resend (solo servidor). Sin la API key las invitaciones salen por Supabase y nadie puede pedir el código para firmar.
RESEND_API_KEY=
# Opcionales. Remitentes, por defecto portal@firmasvc.com y firmas@firmasvc.com.
PORTAL_MAIL_DIRECCION=
FIRMA_MAIL_DIRECCION=

# Google Drive (solo servidor). Pasa los contratos del CRM de Word a PDF.
# JSON completo de la cuenta de servicio, en una línea, y el usuario de Workspace al que representa.
GOOGLE_CREDS_JSON=
GOOGLE_SUBJECT=

# Tareas diarias de Vercel Cron (solo servidor). Una clave larga al azar (openssl rand -hex 32).
CRON_SECRET=

# Firma electrónica (solo servidor). Obligatoria. Clave para los enlaces y los códigos (openssl rand -hex 32).
FIRMA_CLAVE_FIRMAS=

# Resumen semanal y alertas (solo servidor). Obligatoria. Clave para los enlaces de baja del resumen (openssl rand -hex 32).
PORTAL_CLAVE_AVISOS=
